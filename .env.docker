#是否打开模拟
VITE_USE_MOCK=false

#公共路径
VITE_PUBLIC_PATH=/

#超时（秒）
VITE_TIMEOUT=15

#删除控制台
VITE_DROP_CONSOLE=true

#是否启用gzip或brotli压缩
#可选：gzip | brotli |无
#如果你需要多个表单，你可以使用“，”来分隔
VITE_BUILD_COMPRESS='none'
VITE_GLOB_API_URL="__vg_base_url"

#文件上传地址，可选
#可以通过nginx转发或直接写入实际地址
VITE_GLOB_UPLOAD_URL=/api/common/storage/upload

#接口前缀
VITE_GLOB_API_URL_PREFIX=
